# Base de datos (Railway → Postgres → DATABASE_URL)
DATABASE_URL="postgresql://usuario:clave@host:5432/finanzas_jm"

# Firma de las sesiones:            openssl rand -base64 32
AUTH_SECRET=""
# Encriptación de credenciales:     openssl rand -base64 32
ENCRYPTION_KEY=""

# Credenciales de DESARROLLADOR de Colppy (las tuyas, del portal de desarrolladores). Son de Finanzas JM, no de cada cliente.
COLPPY_DEV_USER=""
COLPPY_DEV_PASS=""

# Para la actualización diaria automática (cron de Railway → POST /api/sync con header x-cron-secret)
CRON_SECRET=""

# IA para proponer categorías de cuentas (la misma API key que usa el dashboard de Huerta)
ANTHROPIC_API_KEY=""
